# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.py text eol=lf
*.js text eol=lf
*.vue text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sh text eol=lf

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.pkl binary
*.npy binary
